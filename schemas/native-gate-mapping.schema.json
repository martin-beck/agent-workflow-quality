{
  "$comment": "Canonical UTF-8 JSON with final LF; max 256000 bytes. V1 remains digest-only compatibility evidence. V2 binds observations to a reviewed correlation set and evaluates freshness deterministically.",
  "$id": "https://martin-beck.github.io/agent-workflow-quality/schemas/native-gate-mapping.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappings", "observations", "schema_version"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "evaluated_at": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "mappings": {"type": "array", "minItems": 1, "maxItems": 256},
    "observations": {"type": "array", "minItems": 2, "maxItems": 512}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {
        "properties": {
          "evaluated_at": false,
          "mappings": {"items": {"$ref": "#/$defs/mappingV1"}},
          "observations": {"items": {"$ref": "#/$defs/observationV1"}}
        }
      },
      "else": {
        "required": ["evaluated_at"],
        "properties": {
          "mappings": {"items": {"$ref": "#/$defs/mappingV2"}},
          "observations": {"items": {"$ref": "#/$defs/observationV2"}}
        }
      }
    }
  ],
  "$defs": {
    "awqResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "kind"],
      "properties": {
        "identifier": {"type": "string", "pattern": "^(AWQ-[A-Z]+-[0-9]{3}|ADAPTER-[A-Z0-9]+(?:-[A-Z0-9]+)*)$"},
        "kind": {"enum": ["requirement", "adapter"]}
      }
    },
    "toolPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"}
      }
    },
    "mappingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["awq_result", "claim", "deadline_seconds", "evidence_class", "id", "input_scope", "limitation", "native_command", "requirement", "tier", "tool_pin"],
      "properties": {
        "awq_result": {"$ref": "#/$defs/awqResult"},
        "claim": {"const": "bounded-equivalence-not-certification"},
        "deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "evidence_class": {"enum": ["mechanical", "contract-test", "property-or-fuzz", "bounded-model", "environmental"]},
        "id": {"type": "string", "pattern": "^NATIVE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "input_scope": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "limitation": {"type": "string", "minLength": 1, "maxLength": 500},
        "native_command": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "requirement": {"type": "string", "pattern": "^AWQ-[A-Z]+-[0-9]{3}$"},
        "tier": {"enum": ["local", "pr", "scheduled", "trusted-host", "release"]},
        "tool_pin": {"$ref": "#/$defs/toolPin"}
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_set_id", "source_commit", "source_tree", "reviewed_base", "tree_state", "gate_definition_sha256", "configuration_sha256", "input_sha256", "platform_class"],
      "properties": {
        "observation_set_id": {"type": "string", "maxLength": 100, "pattern": "^SET-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reviewed_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_state": {"const": "clean"},
        "gate_definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "platform_class": {"enum": ["native", "emulated", "hosted-portability", "build-only", "partial"]}
      }
    },
    "mappingV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["awq_result", "claim", "correlation", "deadline_seconds", "evidence_class", "id", "input_scope", "limitation", "native_command", "requirement", "tier", "tool_pin"],
      "properties": {
        "awq_result": {"$ref": "#/$defs/awqResult"},
        "claim": {"const": "bounded-equivalence-not-certification"},
        "correlation": {"$ref": "#/$defs/correlation"},
        "deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "evidence_class": {"enum": ["mechanical", "contract-test", "property-or-fuzz", "bounded-model", "environmental"]},
        "id": {"type": "string", "pattern": "^NATIVE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "input_scope": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "limitation": {"type": "string", "minLength": 1, "maxLength": 500},
        "native_command": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "requirement": {"type": "string", "pattern": "^AWQ-[A-Z]+-[0-9]{3}$"},
        "tier": {"enum": ["local", "pr", "scheduled", "trusted-host", "release"]},
        "tool_pin": {"$ref": "#/$defs/toolPin"}
      }
    },
    "observationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_sha256", "mapping", "source", "status"],
      "properties": {
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mapping": {"type": "string", "pattern": "^NATIVE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "source": {"enum": ["native-gate", "awq-requirement", "awq-adapter"]},
        "status": {"enum": ["pass", "fail", "error", "skip"]}
      }
    },
    "observationV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "mapping", "source", "status"],
      "properties": {
        "identity": {"$ref": "evidence-identity.schema.json"},
        "mapping": {"type": "string", "pattern": "^NATIVE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "source": {"enum": ["native-gate", "awq-requirement", "awq-adapter"]},
        "status": {"enum": ["pass", "fail", "error", "skip"]}
      }
    }
  }
}
