{"$id":"https://github.com/martin-beck/agent-workflow-quality/schemas/adapter-contract.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"argv":{"items":{"maxLength":1000,"minLength":1,"pattern":"^[^\\u0000]*$","type":"string"},"maxItems":100,"minItems":1,"type":"array"},"config_paths":{"items":{"maxLength":1000,"pattern":"^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:\\/|$))(?!.*//).+$","type":"string"},"type":"array","uniqueItems":true},"evidence":{"enum":["mechanical","contract-test","property-or-fuzz","bounded-model","environmental"]},"formats":{"items":{"pattern":"^\\.[a-z0-9]+$","type":"string"},"minItems":1,"type":"array","uniqueItems":true},"id":{"pattern":"^ADAPTER-[A-Z0-9]+(-[A-Z0-9]+)*$","type":"string"},"input_mode":{"enum":["explicit","tracked-formats","tracked-shell"]},"limitation":{"maxLength":500,"minLength":1,"type":"string"},"remediation":{"maxLength":500,"minLength":1,"type":"string"},"tier":{"enum":["local","pr","scheduled","trusted-host","release"]},"timeout_seconds":{"maximum":3600,"minimum":1,"type":"integer"},"tool":{"pattern":"^[A-Za-z0-9][A-Za-z0-9_.+-]*$","type":"string"},"version":{"maxLength":100,"minLength":1,"type":"string"},"version_argv":{"items":{"maxLength":1000,"minLength":1,"pattern":"^[^\\u0000]*$","type":"string"},"maxItems":100,"minItems":1,"type":"array"},"version_output":{"maxLength":200,"minLength":1,"type":"string"}},"required":["id","tool","version","version_argv","version_output","argv","timeout_seconds","tier","evidence","limitation","remediation","formats","config_paths"],"title":"AWQ adapter contract","type":"object"}
