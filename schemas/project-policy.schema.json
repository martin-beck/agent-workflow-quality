{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/martin-beck/agent-workflow-quality/schemas/project-policy.schema.json","title":"AWQ project policy","type":"object","additionalProperties":false,"required":["schema_version","profiles","unknown_formats","fixture_paths","extensions","exceptions","governance"],"properties":{"schema_version":{"const":2},"profiles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"}},"unknown_formats":{"enum":["error","advisory"]},"fixture_paths":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.).+$"}},"extensions":{"type":"array","items":{"$ref":"#/$defs/extension"}},"exceptions":{"type":"array","items":{"$ref":"exception.schema.json"}},"governance":{"$ref":"#/$defs/governance"}},"$defs":{"governance":{"type":"object","additionalProperties":false,"required":["owners","max_standard_days","max_emergency_hours"],"properties":{"owners":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^@[A-Za-z0-9][A-Za-z0-9-]{0,38}(/[A-Za-z0-9_.-]+)?$"}},"max_standard_days":{"type":"integer","minimum":1,"maximum":90},"max_emergency_hours":{"type":"integer","minimum":1,"maximum":72}}},"extension":{"type":"object","additionalProperties":false,"required":["id","tier","argv","timeout_seconds","evidence","limitation","remediation","formats"],"properties":{"id":{"type":"string","pattern":"^LOCAL-[A-Z0-9-]+$"},"tier":{"enum":["local","pr","scheduled","trusted-host","release"]},"argv":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"timeout_seconds":{"type":"integer","minimum":1,"maximum":3600},"evidence":{"enum":["mechanical","contract-test","property-or-fuzz","bounded-model","environmental"]},"limitation":{"type":"string","minLength":1,"maxLength":500},"remediation":{"type":"string","minLength":1,"maxLength":500},"formats":{"type":"array","uniqueItems":true,"items":{"type":"string","p