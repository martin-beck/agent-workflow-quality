{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/martin-beck/agent-workflow-quality/schemas/evidence.schema.json","title":"AWQ evidence envelope","type":"object","additionalProperties":false,"required":["schema_version","awq_version","registry_sha256","policy_sha256","tier","result","requirements"],"properties":{"schema_version":{"const":1},"awq_version":{"type":"string"},"registry_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"policy_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"tier":{"enum":["local","pr","scheduled","trusted-host","release"]},"result":{"enum":["pass","fail"]},"requirements":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","status","evidence","limitation","duration_ms","exceptions","findings"],"properties":{"id":{"type":"string"},"status":{"enum":["pass","fail","not-applicable"]},"evidence":{"enum":["mechanical","contract-test","property-or-fuzz","bounded-model","environmental"]},"limitation":{"type":"string"},"duration_ms":{"type":"integer","minimum":0},"exceptions":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"findings":{"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["code","path","message"],"properties":{"code":{"type":"string"},"path":{"type":"string"},"message":{"type":"string","maxLength":500}}}}}}}}}
