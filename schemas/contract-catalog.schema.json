{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-quality/schemas/contract-catalog.schema.json",
  "title": "Agent Workflow Quality public contract catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contracts"],
  "properties": {
    "schema_version": {"const": 1},
    "contracts": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/contract"}}
  },
  "$defs": {
    "safePath": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"},
    "fixture": {
      "type": "object", "additionalProperties": false, "required": ["path", "case"],
      "properties": {"path": {"$ref": "#/$defs/safePath"}, "case": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,99}$"}}
    },
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "path", "kind", "status", "assurance", "positive_fixtures", "hostile_fixtures", "implementation_conformance", "test_argv", "documentation", "limitation"],
      "properties": {
        "id": {"type": "string", "pattern": "^AWQ-CONTRACT-[A-Z0-9][A-Z0-9-]{2,79}-V[1-9][0-9]*$"},
        "version": {"type": "integer", "minimum": 1, "maximum": 999},
        "path": {"$ref": "#/$defs/safePath"},
        "kind": {"enum": ["json-schema", "structured-registry"]},
        "status": {"enum": ["active", "historical", "deprecated"]},
        "assurance": {"enum": ["shape", "implementation-conformance"]},
        "positive_fixtures": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/fixture"}},
        "hostile_fixtures": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/fixture"}},
        "implementation_conformance": {"type": "string", "pattern": "^awq\\.[A-Za-z0-9_.-]{3,120}$"},
        "test_argv": {"type": "array", "minItems": 4, "maxItems": 12, "prefixItems": [{"const": "python"}, {"const": "-m"}, {"const": "unittest"}], "items": {"type": "string", "minLength": 1, "maxLength": 160}},
        "documentation": {"$ref": "#/$defs/safePath"},
        "limitation": {"type": "string", "minLength": 20, "maxLength": 500}
      }
    }
  }
}
