{
  "$id": "https://github.com/martin-beck/agent-workflow-quality/schemas/assurance-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded consumer assurance plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "evaluated_at", "domains", "gates", "unsupported", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"$ref": "#/$defs/repository"},
    "evaluated_at": {"$ref": "#/$defs/timestamp"},
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/domain"}
    },
    "gates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/gate"}
    },
    "unsupported": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/unsupported"}
    },
    "observations": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "owner": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "timestamp": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_commit", "source_tree", "reviewed_base", "tree_state"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "source_tree": {"$ref": "#/$defs/commit"},
        "reviewed_base": {"$ref": "#/$defs/commit"},
        "tree_state": {"const": "clean"}
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "owner", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^DOMAIN-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "kind": {"enum": ["language", "build-system", "runtime-surface", "quality-domain"]},
        "owner": {"$ref": "#/$defs/owner"},
        "description": {"type": "string", "minLength": 20, "maxLength": 500, "pattern": "^[\\x20-\\x7E]+$"}
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "source_tree", "reviewed_base", "tree_state", "gate_definition_sha256", "configuration_sha256", "input_sha256", "platform_class"],
      "properties": {
        "source_commit": {"$ref": "#/$defs/commit"},
        "source_tree": {"$ref": "#/$defs/commit"},
        "reviewed_base": {"$ref": "#/$defs/commit"},
        "tree_state": {"const": "clean"},
        "gate_definition_sha256": {"$ref": "#/$defs/hash"},
        "configuration_sha256": {"$ref": "#/$defs/hash"},
        "input_sha256": {"$ref": "#/$defs/hash"},
        "platform_class": {"enum": ["native", "emulated", "hosted-portability", "build-only", "partial"]}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "invariant", "domains", "tier", "evidence_class", "argv", "input_scope", "report_contract", "remediation", "limitation", "depends_on", "native_mapping", "correlation"],
      "properties": {
        "id": {"type": "string", "pattern": "^GATE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "owner": {"$ref": "#/$defs/owner"},
        "invariant": {"type": "string", "pattern": "^INV-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^DOMAIN-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}
        },
        "tier": {"enum": ["local", "pr", "scheduled", "trusted-host", "release"]},
        "evidence_class": {"enum": ["mechanical", "contract-test", "property-or-fuzz", "bounded-model", "environmental"]},
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?![/~])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*://)(?!.*(?:\\$|`|;|&&|\\|\\|))[\\x20-\\x7E]+$"}
        },
        "input_scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?![/~])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[:\\\\])[\\x20-\\x7E]+$"}
        },
        "report_contract": {"type": "string", "pattern": "^AWQ-CONTRACT-[A-Z0-9]+(?:-[A-Z0-9]+)*-V[1-9][0-9]*$"},
        "remediation": {"type": "string", "minLength": 20, "maxLength": 500, "pattern": "^[\\x20-\\x7E]+$"},
        "limitation": {"type": "string", "minLength": 20, "maxLength": 500, "pattern": "^[\\x20-\\x7E]+$"},
        "depends_on": {
          "type": "array",
          "maxItems": 255,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^GATE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}
        },
        "native_mapping": {
          "type": ["string", "null"],
          "pattern": "^NATIVE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "correlation": {"$ref": "#/$defs/correlation"}
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "owner", "rationale", "review"],
      "properties": {
        "id": {"type": "string", "pattern": "^UNSUPPORTED-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "domain": {"type": "string", "pattern": "^DOMAIN-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "owner": {"$ref": "#/$defs/owner"},
        "rationale": {"type": "string", "minLength": 20, "maxLength": 500, "pattern": "^[\\x20-\\x7E]+$"},
        "review": {"type": "string", "pattern": "^REVIEW-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "source", "status", "identity"],
      "properties": {
        "gate": {"type": "string", "pattern": "^GATE-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
        "source": {"enum": ["executed", "native-environment"]},
        "status": {"enum": ["pass", "fail", "error", "skip"]},
        "identity": {"$ref": "https://martin-beck.github.io/agent-workflow-quality/schemas/evidence-identity.schema.json"}
      }
    }
  }
}
