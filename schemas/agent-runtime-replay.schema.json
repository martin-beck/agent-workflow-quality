{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://martin-beck.github.io/agent-workflow-quality/schemas/agent-runtime-replay.schema.json",
  "title": "AWQ synthetic agent-runtime replay contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "classification", "cassette", "launch", "consumption", "limitations", "non_claims"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "agent-runtime-replay"},
    "classification": {"const": "synthetic-replay"},
    "cassette": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "redaction", "limits", "normalization", "interactions"],
      "properties": {
        "id": {"$ref": "#/$defs/cassetteId"},
        "redaction": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "stage", "rules_sha256"],
          "properties": {
            "version": {"const": "awq-redaction-v1"},
            "stage": {"const": "pre-serialization"},
            "rules_sha256": {"$ref": "#/$defs/digest"}
          }
        },
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["max_bytes", "max_interactions", "max_events", "max_frames", "max_headers", "max_retries", "max_virtual_ms"],
          "properties": {
            "max_bytes": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "max_interactions": {"type": "integer", "minimum": 1, "maximum": 128},
            "max_events": {"type": "integer", "minimum": 1, "maximum": 1024},
            "max_frames": {"type": "integer", "minimum": 0, "maximum": 1024},
            "max_headers": {"type": "integer", "minimum": 0, "maximum": 64},
            "max_retries": {"type": "integer", "minimum": 0, "maximum": 16},
            "max_virtual_ms": {"type": "integer", "minimum": 0, "maximum": 3600000}
          }
        },
        "normalization": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "headers", "query", "body"],
          "properties": {
            "method": {"const": "uppercase"},
            "headers": {"const": "lowercase-sorted"},
            "query": {"const": "canonical-sorted"},
            "body": {"const": "sha256-only"}
          }
        },
        "interactions": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {"$ref": "#/$defs/interaction"}
        }
      }
    },
    "launch": {"$ref": "#/$defs/launch"},
    "consumption": {
      "type": "object", "additionalProperties": false,
      "required": ["interactions", "events", "frames", "retries", "unconsumed_frames"],
      "properties": {
        "interactions": {"type": "integer", "minimum": 1, "maximum": 128},
        "events": {"type": "integer", "minimum": 1, "maximum": 1024},
        "frames": {"type": "integer", "minimum": 0, "maximum": 1024},
        "retries": {"type": "integer", "minimum": 0, "maximum": 16},
        "unconsumed_frames": {"const": 0}
      }
    },
    "limitations": {
      "const": [
        "Synthetic replay does not establish live provider compatibility or model quality.",
        "Digest commitments do not retain prompts, responses, credentials, or subprocess output.",
        "Consumer-native gates and live environmental observations remain independently required."
      ]
    },
    "non_claims": {
      "const": ["live-provider-compatibility", "model-quality", "provider-equivalence", "sandbox-containment"]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "token": {"type": "string", "maxLength": 80, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+){0,7}$"},
    "version": {"type": "string", "maxLength": 100, "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][0-9A-Za-z.-]+)?$"},
    "cassetteId": {"type": "string", "maxLength": 100, "pattern": "^CASSETTE-[A-Z0-9]+(?:-[A-Z0-9]+){0,7}$"},
    "identifier": {"type": "string", "maxLength": 100, "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+){1,7}$"},
    "tokens": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "correlation_id", "request", "events", "retry"],
      "properties": {
        "id": {"type": "string", "pattern": "^INTERACTION-[0-9]{4}$"},
        "correlation_id": {"type": "string", "pattern": "^CORRELATION-[A-Z0-9]+(?:-[A-Z0-9]+){0,7}$"},
        "request": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "route_id", "headers", "body_sha256", "match_sha256"],
          "properties": {
            "method": {"enum": ["DELETE", "GET", "PATCH", "POST", "PUT"]},
            "route_id": {"$ref": "#/$defs/token"},
            "headers": {
              "type": "array", "maxItems": 64,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["name", "value_sha256"],
                "properties": {"name": {"$ref": "#/$defs/token"}, "value_sha256": {"$ref": "#/$defs/digest"}}
              }
            },
            "body_sha256": {"$ref": "#/$defs/digest"},
            "match_sha256": {"$ref": "#/$defs/digest"}
          }
        },
        "events": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/event"}},
        "retry": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "retry_of", "idempotency_proof_sha256"],
          "properties": {
            "mode": {"enum": ["none", "consumer-authorized"]},
            "retry_of": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^INTERACTION-[0-9]{4}$"}]},
            "idempotency_proof_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}
          }
        }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "virtual_ms", "type", "correlation_id", "frame_sha256", "delivery", "fault"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 1024},
        "virtual_ms": {"type": "integer", "minimum": 0, "maximum": 3600000},
        "type": {"enum": ["request-accepted", "response-frame", "fault", "cancelled", "completed"]},
        "correlation_id": {"type": "string", "pattern": "^CORRELATION-[A-Z0-9]+(?:-[A-Z0-9]+){0,7}$"},
        "frame_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "delivery": {"enum": ["not-applicable", "certain", "uncertain"]},
        "fault": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "seed"],
              "properties": {
                "kind": {"enum": ["connection-reset", "seeded-delay", "truncation"]},
                "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}
              }
            }
          ]
        }
      }
    },
    "launch": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "provider", "model", "runtime", "workload", "source", "run", "argv", "environment", "prompt_transport", "credential_resolver", "network", "telemetry", "adapter_set"],
      "properties": {
        "adapter": {"$ref": "#/$defs/versionedId"},
        "provider": {
          "type": "object", "additionalProperties": false, "required": ["id", "endpoint_class"],
          "properties": {"id": {"$ref": "#/$defs/identifier"}, "endpoint_class": {"$ref": "#/$defs/token"}}
        },
        "model": {
          "type": "object", "additionalProperties": false, "required": ["id", "settings_sha256"],
          "properties": {"id": {"$ref": "#/$defs/identifier"}, "settings_sha256": {"$ref": "#/$defs/digest"}}
        },
        "runtime": {
          "type": "object", "additionalProperties": false, "required": ["name", "version", "executable_sha256"],
          "properties": {"name": {"$ref": "#/$defs/token"}, "version": {"$ref": "#/$defs/version"}, "executable_sha256": {"$ref": "#/$defs/digest"}}
        },
        "workload": {
          "type": "object", "additionalProperties": false, "required": ["id", "sha256"],
          "properties": {"id": {"$ref": "#/$defs/identifier"}, "sha256": {"$ref": "#/$defs/digest"}}
        },
        "source": {
          "type": "object", "additionalProperties": false, "required": ["commit", "tree"],
          "properties": {"commit": {"$ref": "#/$defs/commit"}, "tree": {"$ref": "#/$defs/commit"}}
        },
        "run": {
          "type": "object", "additionalProperties": false, "required": ["id", "attempt"],
          "properties": {"id": {"$ref": "#/$defs/identifier"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 1000}}
        },
        "argv": {
          "type": "object", "additionalProperties": false, "required": ["count", "sha256"],
          "properties": {"count": {"type": "integer", "minimum": 1, "maximum": 64}, "sha256": {"$ref": "#/$defs/digest"}}
        },
        "environment": {
          "type": "object", "additionalProperties": false, "required": ["names", "sha256"],
          "properties": {"names": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}, "sha256": {"$ref": "#/$defs/digest"}}
        },
        "prompt_transport": {
          "type": "object", "additionalProperties": false, "required": ["mode", "content_sha256"],
          "properties": {"mode": {"const": "digest-only"}, "content_sha256": {"$ref": "#/$defs/digest"}}
        },
        "credential_resolver": {
          "type": "object", "additionalProperties": false, "required": ["id", "config_sha256"],
          "properties": {"id": {"$ref": "#/$defs/identifier"}, "config_sha256": {"$ref": "#/$defs/digest"}}
        },
        "network": {
          "type": "object", "additionalProperties": false, "required": ["mode", "endpoint_count"],
          "properties": {"mode": {"const": "replay-only"}, "endpoint_count": {"const": 0}}
        },
        "telemetry": {
          "type": "object", "additionalProperties": false, "required": ["mode"],
          "properties": {"mode": {"const": "disabled"}}
        },
        "adapter_set": {
          "type": "object", "additionalProperties": false, "required": ["requested", "preserved", "unsupported"],
          "properties": {"requested": {"$ref": "#/$defs/tokens"}, "preserved": {"$ref": "#/$defs/tokens"}, "unsupported": {"$ref": "#/$defs/tokens"}}
        }
      }
    },
    "versionedId": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"$ref": "#/$defs/identifier"}, "version": {"$ref": "#/$defs/version"}}
    }
  }
}
