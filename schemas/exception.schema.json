{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/martin-beck/agent-workflow-quality/schemas/exception.schema.json","title":"AWQ exception","type":"object","additionalProperties":false,"required":["id","requirement","owner","reason","scope","created_at","expires_at","compensating_evidence","review"],"properties":{"id":{"type":"string","pattern":"^EX-[0-9]{4}$"},"requirement":{"type":"string","pattern":"^AWQ-[A-Z]+-[0-9]{3}$"},"owner":{"type":"string","minLength":1,"maxLength":80},"reason":{"type":"string","minLength":1,"maxLength":500},"scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.).+$"}},"created_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"compensating_evidence":{"type":"string","minLength":1,"maxLength":500},"review":{"type":"string","minLength":1,"maxLength":200}}}
