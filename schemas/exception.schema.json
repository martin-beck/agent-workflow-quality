{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-quality/schemas/exception.schema.json",
  "title": "AWQ exception",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "requirement",
    "owner",
    "reason",
    "scope",
    "created_at",
    "expires_at",
    "compensating_evidence",
    "approval",
    "renewals",
    "revocation"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^EX-[0-9]{4}$"},
    "kind": {"enum": ["standard", "emergency"]},
    "requirement": {"type": "string", "pattern": "^AWQ-[A-Z]+-[0-9]{3}$"},
    "owner": {"$ref": "#/$defs/owner"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 500},
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "compensating_evidence": {"type": "string", "minLength": 1, "maxLength": 500},
    "approval": {"$ref": "#/$defs/approval"},
    "renewals": {"type": "array", "items": {"$ref": "#/$defs/renewal"}},
    "revocation": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/revocation"}]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "emergency"}}, "required": ["kind"]},
      "then": {"properties": {"renewals": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "owner": {
      "type": "string",
      "pattern": "^@[A-Za-z0-9][A-Za-z0-9-]{0,38}(/[A-Za-z0-9_.-]+)?$"
    },
    "approval": {
      "type": "string",
      "format": "uri",
      "pattern": "^(urn:[^\\s]+|https://(?![^/\\s]*@)[^\\s]+)$"
    },
    "renewal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renewed_at",
        "previous_expires_at",
        "expires_at",
        "owner",
        "reason",
        "approval"
      ],
      "properties": {
        "renewed_at": {"type": "string", "format": "date-time"},
        "previous_expires_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "owner": {"$ref": "#/$defs/owner"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "approval": {"$ref": "#/$defs/approval"}
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revoked_at", "owner", "reason", "approval"],
      "properties": {
        "revoked_at": {"type": "string", "format": "date-time"},
        "owner": {"$ref": "#/$defs/owner"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "approval": {"$ref": "#/$defs/approval"}
      }
    }
  }
}
