{
  "$id": "https://github.com/martin-beck/agent-workflow-quality/schemas/discussion-reconciliation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": ["schema_version", "discussion_id", "task", "event_refs", "before", "after", "changed_artifacts", "prior_formal_result_sha256", "formal_spec", "affected_ars", "acceptance", "limitations", "privacy_projection"],
  "properties": {
    "schema_version": {"const": 1},
    "discussion_id": {"pattern": "^DISC-[A-Z0-9-]{2,68}$", "type": "string"},
    "task": {"$ref": "#/$defs/task"},
    "event_refs": {"items": {"pattern": "^EV-[A-Z0-9-]{1,63}$", "type": "string"}, "minItems": 1, "maxItems": 32, "uniqueItems": true, "type": "array"},
    "before": {"$ref": "#/$defs/artifacts"},
    "after": {"$ref": "#/$defs/artifacts"},
    "changed_artifacts": {"items": {"enum": ["plan", "design", "dependency_graph", "specification"]}, "minItems": 1, "maxItems": 4, "uniqueItems": true, "type": "array"},
    "prior_formal_result_sha256": {"$ref": "#/$defs/sha256"},
    "formal_spec": {"additionalProperties": false, "type": "object", "required": ["specification_sha256", "result_sha256", "review_sha256", "task_revision", "status"], "properties": {"specification_sha256": {"$ref": "#/$defs/sha256"}, "result_sha256": {"$ref": "#/$defs/sha256"}, "review_sha256": {"$ref": "#/$defs/sha256"}, "task_revision": {"type": "integer", "minimum": 1, "maximum": 1000000}, "status": {"const": "pass"}}},
    "affected_ars": {"items": {"$ref": "#/$defs/affected"}, "minItems": 1, "maxItems": 64, "type": "array"},
    "acceptance": {"additionalProperties": false, "type": "object", "required": ["user_guidance", "quality_evidence", "implementation_verification"], "properties": {"user_guidance": {"enum": ["accepted", "rejected"]}, "quality_evidence": {"const": "pass"}, "implementation_verification": {"enum": ["verified", "not_verified", "not_applicable"]}}},
    "limitations": {"items": {"enum": ["user_intent_not_proven", "implementation_correctness_not_proven", "consumer_native_gates_remain_authoritative", "formal_refinement_not_proven"]}, "minItems": 4, "maxItems": 4, "uniqueItems": true, "type": "array"},
    "privacy_projection": {"additionalProperties": false, "type": "object", "required": ["public_safe", "projection_sha256", "redacted_fields"], "properties": {"public_safe": {"const": true}, "projection_sha256": {"$ref": "#/$defs/sha256"}, "redacted_fields": {"items": {"pattern": "^[a-z][a-z0-9_]{0,63}$", "type": "string"}, "maxItems": 64, "uniqueItems": true, "type": "array"}}}
  },
  "$defs": {
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "task": {"additionalProperties": false, "type": "object", "required": ["id", "revision"], "properties": {"id": {"pattern": "^AR-[0-9]{4}$", "type": "string"}, "revision": {"type": "integer", "minimum": 1, "maximum": 1000000}}},
    "artifacts": {"additionalProperties": false, "type": "object", "required": ["plan_sha256", "design_sha256", "dependency_graph_sha256", "specification_sha256"], "properties": {"plan_sha256": {"$ref": "#/$defs/sha256"}, "design_sha256": {"$ref": "#/$defs/sha256"}, "dependency_graph_sha256": {"$ref": "#/$defs/sha256"}, "specification_sha256": {"$ref": "#/$defs/sha256"}}},
    "affected": {"additionalProperties": false, "type": "object", "required": ["id", "before_revision", "after_revision", "disposition"], "properties": {"id": {"pattern": "^AR-[0-9]{4}$", "type": "string"}, "before_revision": {"type": "integer", "minimum": 1}, "after_revision": {"type": "integer", "minimum": 1}, "disposition": {"enum": ["unchanged", "closed", "reopened"]}}}
  }
}
