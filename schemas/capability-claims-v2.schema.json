{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/martin-beck/agent-workflow-quality/schemas/capability-claims-v2.schema.json","additionalProperties":false,"type":"object","required":["schema_version","claims"],"properties":{"schema_version":{"const":1},"claims":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"object","additionalProperties":false,"required":["id","maturity","transition","source_scope","supported_surfaces","owner","limitations","review","evidence"],"properties":{"id":{"pattern":"^AWQ-CAP-[A-Z0-9]+(?:-[A-Z0-9]+)*$","type":"string"},"maturity":{"enum":["planned","foundation","implemented","integrated","environment-verified","unsupported","deprecated"]},"source_scope":{"type":"object","additionalProperties":false,"required":["repository","path","commit","tree"],"properties":{"repository":{"type":"string"},"commit":{"pattern":"^[0-9a-f]{40}$","type":"string"},"tree":{"pattern":"^[0-9a-f]{64}$","type":"string"}}},"supported_surfaces":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["cli","python-api","schema","release","native-gate","documentation"]}},"owner":{"type":"string"},"limitations":{"type":"array","minItems":1,"items":{"type":"string","minLength":10,"maxLength":300}},"review":{"type":"object","additionalProperties":false,"required":["id","reviewed_at","reviewer"],"properties":{"id":{"pattern":"^REVIEW-[A-Z0-9-]+$","type":"string"},"reviewed_at":{"type":"string"},"reviewer":{"type":"string"}}},"evidence":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","class","digest","observed_at","freshness_seconds","source_commit","origin"],"properties":{"id":{"pattern":"^EVIDENCE-[A-Z0-9-]+$","type":"string"},"class":{"enum":["mechanical","contract-test","property-or-fuzz","bounded-model","environmental"]},"digest":{"pattern":"^[0-9a-f]{64}$","type":"string"},"observed_at":{"type":"string"},"freshness_seconds":{"type":"integer","minimum":1,"maximum