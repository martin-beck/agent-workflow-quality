{"$id":"https://github.com/martin-beck/agent-workflow-quality/schemas/lock.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"allOf":[{"else":{"not":{"required":["receipt"]}},"if":{"properties":{"schema_version":{"const":2}}},"then":{"required":["receipt"]}}],"properties":{"awq_version":{"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$","type":"string"},"profiles":{"items":{"pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$","type":"string"},"maxItems":2000,"type":"array","uniqueItems":true},"receipt":{"additionalProperties":false,"properties":{"manifest_sha256":{"pattern":"^[a-f0-9]{64}$","type":"string"},"policy_generation":{"maximum":1000,"minimum":1,"type":"integer"},"policy_sha256":{"pattern":"^[a-f0-9]{64}$","type":"string"},"provenance_sha256":{"pattern":"^[a-f0-9]{64}$","type":"string"},"signature_sha256":{"pattern":"^[a-f0-9]{64}$","type":"string"},"signer":{"pattern":"^[A-Za-z0-9][A-Za-z0-9_.@+-]{0,127}$","type":"string"},"signer_fingerprint":{"pattern":"^SHA256:[A-Za-z0-9+/]{43}$","type":"string"},"source_commit":{"pattern":"^[a-f0-9]{40}$","type":"string"},"tag_object":{"pattern":"^[a-f0-9]{40}$","type":"string"},"tag_ref":{"pattern":"^refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+$","type":"string"},"trust_policy":{"$ref":"https://github.com/martin-beck/agent-workflow-quality/schemas/release-trust-policy.schema.json"}},"required":["manifest_sha256","source_commit","tag_object","policy_sha256","policy_generation","signer","signer_fingerprint","trust_policy","provenance_sha256","signature_sha256","tag_ref"],"type":"object"},"registry_sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"requirements":{"items":{"pattern":"^AWQ-[A-Z]+-[0-9]{3}$","type":"string"},"maxItems":2000,"type":"array","uniqueItems":true},"schema_version":{"enum":[1,2]}},"required":["schema_version","awq_version","registry_sha256","profiles","requirements"],"title":"AWQ policy lock","type":"object"}
