{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/martin-beck/agent-workflow-quality/schemas/lock.schema.json","title":"AWQ policy lock","type":"object","additionalProperties":false,"required":["schema_version","awq_version","registry_sha256","profiles","requirements"],"properties":{"schema_version":{"const":1},"awq_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"registry_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"profiles":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"requirements":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^AWQ-[A-Z]+-[0-9]{3}$"}}}}
