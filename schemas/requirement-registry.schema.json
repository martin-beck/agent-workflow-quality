{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/martin-beck/agent-workflow-quality/schemas/requirement-registry.schema.json","title":"AWQ requirement registry","type":"object","additionalProperties":false,"required":["schema_version","requirements"],"properties":{"schema_version":{"const":1},"requirements":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","title","statement","profiles","tier","severity","deterministic","network","command","evidence","limitation","remediation","exception_policy","standards"],"properties":{"id":{"type":"string","pattern":"^AWQ-[A-Z]+-[0-9]{3}$"},"title":{"type":"string","minLength":1},"statement":{"type":"string","minLength":1},"profiles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"tier":{"enum":["local","pr","scheduled","trusted-host","release"]},"severity":{"enum":["error","warning","advisory"]},"deterministic":{"type":"boolean"},"network":{"type":"boolean"},"command":{"type":"string","minLength":1},"evidence":{"enum":["mechanical","contract-test","property-or-fuzz","bounded-model","environmental"]},"limitation":{"type":"string","minLength":1},"remediation":{"type":"string","minLength":1},"exception_policy":{"type":"string","minLength":1},"standards":{"type":"array","uniqueItems":true,"items":{"type":"string"}}}}}}}
