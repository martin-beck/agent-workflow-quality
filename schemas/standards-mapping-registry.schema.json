{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/martin-beck/agent-workflow-quality/schemas/standards-mapping-registry.schema.json","title":"AWQ standards mapping registry","type":"object","additionalProperties":false,"required":["schema_version","mappings"],"properties":{"schema_version":{"const":1},"mappings":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","requirement","source","edition","control","relationship","rationale","evidence","limitation","reviewer","claim"],"properties":{"id":{"type":"string","pattern":"^MAP-AWQ-[A-Z0-9.-]+$"},"requirement":{"type":"string","pattern":"^AWQ-[A-Z]+-[0-9]{3}$"},"source":{"type":"string","pattern":"^[A-Z][A-Z0-9-]+$"},"edition":{"type":"string","minLength":1},"control":{"type":"string","minLength":1},"relationship":{"enum":["aligned","supports","related"]},"rationale":{"type":"string","minLength":1},"evidence":{"enum":["mechanical","contract-test","property-or-fuzz","bounded-model","environmental"]},"limitation":{"type":"string","minLength":1},"reviewer":{"type":"string","minLength":1},"claim":{"const":"alignment-not-certification"}}}}}}
